rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own onboarding data
    match /user_onboarding/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can only access their own transaction data
    match /user_transactions/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can only access their own budget data
    match /user_budgets/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can only access their own savings goals
    match /user_savings_goals/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can only access their own categories and subcategories
    match /user_categories/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can only access their own reminders
    match /user_reminders/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can only access their own reports
    match /user_reports/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can only access their own settings
    match /user_settings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can only access their own backup metadata
    match /user_backups/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public read access for app configuration (if needed in future)
    match /app_config/{document} {
      allow read: if true;
      allow write: if false; // Only server-side writes allowed
    }
  }
}